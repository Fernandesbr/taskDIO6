# Copie para .env (ou para os Secrets do Colab) e preencha. Nunca faça commit do .env.

# Token compartilhado entre n8n (credencial Header Auth) e o serviço Colab
API_KEY=troque-por-um-token-longo-e-aleatorio

# Token gratuito da brapi.dev
BRAPI_TOKEN=

# Token do ngrok (para expor o serviço do Colab)
NGROK_AUTHTOKEN=

# URL pública do túnel, usada como variável no n8n
COLAB_URL=https://seu-tunel.ngrok-free.app
